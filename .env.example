# Copy only if .env does not exist. Never overwrite an existing API key or commit secrets.
# From the project root: .venv/Scripts/python.exe scripts/configure_database.py
# Enter the two account passwords at the hidden prompts, not in this example.
# The helper stores encoded passwords in these URLs; no separate password variable is used.
TERMSLENS_DATABASE_URL=
TERMSLENS_TEST_DATABASE_URL=
TERMSLENS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
TERMSLENS_SECURE_COOKIES=false

# Keep your existing Groq key in private .env only. A key alone does not enable calls.
# Keep Groq disabled until readiness evidence and live-call authorization are established.
GROQ_API_KEY=
# User-selected model; account availability and readiness still require verification.
TERMSLENS_GROQ_MODEL=openai/gpt-oss-20b
TERMSLENS_GROQ_ENABLED=false
TERMSLENS_GROQ_READINESS_FILE=var/groq-readiness.json
